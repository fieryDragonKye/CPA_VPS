+++ b/internal/runtime/executor/helps/codex_transport_trace_test.go
@@ -0,0 +1,198 @@
+package helps
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptrace"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+	log "github.com/sirupsen/logrus"
+	"github.com/sirupsen/logrus/hooks/test"
+	"golang.org/x/net/http2"
+)
+
+func enableTransportTrace(t *testing.T) *test.Hook {
+	t.Helper()
+	flag := filepath.Join(t.TempDir(), "enabled")
+	if err := os.WriteFile(flag, []byte("enabled"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("CPA_CODEX_TRANSPORT_TRACE_FILE", flag)
+	logger := log.StandardLogger()
+	oldHooks := logger.ReplaceHooks(make(log.LevelHooks))
+	oldLevel := logger.GetLevel()
+	hook := test.NewGlobal()
+	logger.SetLevel(log.InfoLevel)
+	t.Cleanup(func() { logger.ReplaceHooks(oldHooks); logger.SetLevel(oldLevel) })
+	return hook
+}
+
+func TestCodexTransportTraceGateAndPrivacy(t *testing.T) {
+	hook := enableTransportTrace(t)
+	req, _ := http.NewRequest("POST", "https://chatgpt.com/backend-api/codex/responses?secret=hidden-query", strings.NewReader("private-prompt"))
+	req.Header.Set("Authorization", "Bearer hidden-token")
+	req = req.WithContext(logging.WithRequestID(req.Context(), "credential-is-not-a-uuid"))
+	traced, trace := beginCodexTransportTrace(req)
+	trace.event("test_error", errors.New("hidden-token private-prompt hidden-query"), nil)
+	if traced.Body != req.Body || traced.Header.Get("Authorization") != req.Header.Get("Authorization") {
+		t.Fatal("request changed")
+	}
+	if trace.requestID != "" {
+		t.Fatal("unvalidated request ID recorded")
+	}
+	for _, entry := range hook.AllEntries() {
+		text := fmt.Sprint(entry.Data)
+		formatted, err := (&logging.LogFormatter{}).Format(entry)
+		if err != nil || !strings.Contains(string(formatted), "stage=") || !strings.Contains(string(formatted), "trace_attempt=") {
+			t.Fatalf("diagnostic fields dropped by production formatter: %s %v", formatted, err)
+		}
+		text += string(formatted)
+		for _, secret := range []string{"private-prompt", "hidden-token", "hidden-query", "credential-is-not-a-uuid"} {
+			if strings.Contains(text, secret) {
+				t.Fatalf("secret logged: %s", secret)
+			}
+		}
+	}
+	other, _ := http.NewRequest("GET", "https://other.invalid/", nil)
+	if same, tr := beginCodexTransportTrace(other); same != other || tr != nil {
+		t.Fatal("other host traced")
+	}
+	if err := os.Remove(os.Getenv("CPA_CODEX_TRANSPORT_TRACE_FILE")); err != nil {
+		t.Fatal(err)
+	}
+	if same, tr := beginCodexTransportTrace(req); same != req || tr != nil {
+		t.Fatal("removed flag still enabled")
+	}
+}
+
+type traceFailureDialer struct{ err error }
+
+func (d traceFailureDialer) Dial(network, addr string) (net.Conn, error) {
+	return d.DialContext(context.Background(), network, addr)
+}
+func (d traceFailureDialer) DialContext(context.Context, string, string) (net.Conn, error) {
+	return nil, d.err
+}
+
+func TestCodexTransportTraceDialFailure(t *testing.T) {
+	hook := enableTransportTrace(t)
+	req, _ := http.NewRequest("POST", "https://chatgpt.com/backend-api/codex/responses", nil)
+	want := errors.New("sensitive error detail")
+	_, err := (&utlsRoundTripper{dialer: traceFailureDialer{err: want}}).RoundTrip(req)
+	if !errors.Is(err, want) {
+		t.Fatalf("error changed: %v", err)
+	}
+	stages := []string{}
+	for _, entry := range hook.AllEntries() {
+		stages = append(stages, entry.Data["stage"].(string))
+	}
+	if strings.Join(stages, ",") != "start,proxy_dial_start,proxy_dial_end,transport_error" {
+		t.Fatalf("stages: %v", stages)
+	}
+}
+
+func TestCodexTransportTraceTLSFailure(t *testing.T) {
+	hook := enableTransportTrace(t)
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	go func() {
+		conn, e := listener.Accept()
+		if e != nil {
+			return
+		}
+		defer conn.Close()
+		buf := make([]byte, 32768)
+		_, _ = conn.Read(buf)
+	}()
+	dialer := &traceLocalDialer{address: listener.Addr().String()}
+	req, _ := http.NewRequestWithContext(t.Context(), "POST", "https://chatgpt.com/backend-api/codex/responses", nil)
+	_, err = (&utlsRoundTripper{dialer: dialer}).RoundTrip(req)
+	if err == nil {
+		t.Fatal("wanted TLS failure")
+	}
+	seenTLS := false
+	for _, entry := range hook.AllEntries() {
+		if entry.Data["stage"] == "tls_end" {
+			seenTLS = true
+			if entry.Data["local_port"].(int) == 0 || entry.Data["error_class"] == "none" {
+				t.Fatal("missing failure metadata")
+			}
+		}
+	}
+	if !seenTLS {
+		t.Fatal("no TLS stage")
+	}
+}
+
+type traceLocalDialer struct{ address string }
+
+func (d *traceLocalDialer) Dial(network, addr string) (net.Conn, error) {
+	return d.DialContext(context.Background(), network, addr)
+}
+func (d *traceLocalDialer) DialContext(ctx context.Context, network, addr string) (net.Conn, error) {
+	return (&net.Dialer{}).DialContext(ctx, network, d.address)
+}
+
+func TestCodexTransportTraceHTTPAndBodyPreserved(t *testing.T) {
+	for _, protocol := range []string{"h2", "http/1.1"} {
+		t.Run(protocol, func(t *testing.T) {
+			hook := enableTransportTrace(t)
+			conn, _, _ := newALPNTestConnection(t, protocol, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { _, _ = io.WriteString(w, "private-response") }))
+			req, _ := http.NewRequest("GET", "https://chatgpt.com/backend-api/codex/responses", nil)
+			var prior atomic.Int32
+			req = req.WithContext(httptrace.WithClientTrace(req.Context(), &httptrace.ClientTrace{GotFirstResponseByte: func() { prior.Add(1) }}))
+			req, tr := beginCodexTransportTrace(req)
+			resp, err := roundTripUtlsConnection(req, conn)
+			if err != nil {
+				t.Fatal(err)
+			}
+			body := &codexTraceBody{ReadCloser: resp.Body, trace: tr}
+			got, err := io.ReadAll(body)
+			if err != nil || string(got) != "private-response" {
+				t.Fatalf("body changed: %q %v", got, err)
+			}
+			_ = body.Close()
+			if prior.Load() != 1 {
+				t.Fatal("existing trace hook lost")
+			}
+			terminal, first := 0, 0
+			for _, entry := range hook.AllEntries() {
+				if entry.Data["stage"] == "body_end" || entry.Data["stage"] == "body_closed" {
+					terminal++
+				}
+				if entry.Data["stage"] == "first_body_read" {
+					first++
+				}
+				if strings.Contains(fmt.Sprint(entry.Data), "private-response") {
+					t.Fatal("response logged")
+				}
+			}
+			if terminal != 1 || first != 1 {
+				t.Fatalf("events duplicated: terminal=%d first=%d", terminal, first)
+			}
+		})
+	}
+}
+
+func TestCodexTransportTraceClassifiesHTTP2AndCancellation(t *testing.T) {
+	for _, tc := range []struct {
+		err  error
+		want string
+	}{{fmt.Errorf("wrapped: %w", http2.StreamError{StreamID: 1, Code: http2.ErrCodeProtocol}), "h2_stream_PROTOCOL_ERROR"}, {http2.ConnectionError(http2.ErrCodeProtocol), "h2_connection_PROTOCOL_ERROR"}, {context.Canceled, "context_canceled"}, {context.DeadlineExceeded, "deadline_exceeded"}, {io.EOF, "eof"}, {errors.New("private detail"), "other"}} {
+		if got := traceErrorClass(tc.err); got != tc.want {
+			t.Fatalf("got %s want %s", got, tc.want)
+		}
+	}
+}
