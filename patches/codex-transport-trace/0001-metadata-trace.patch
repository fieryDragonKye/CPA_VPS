diff --git a/internal/runtime/executor/helps/codex_transport_trace.go b/internal/runtime/executor/helps/codex_transport_trace.go
new file mode 100644
index 0000000..3654b42
--- /dev/null
+++ b/internal/runtime/executor/helps/codex_transport_trace.go
@@ -0,0 +1,173 @@
+package helps
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptrace"
+	"os"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+	log "github.com/sirupsen/logrus"
+	"golang.org/x/net/http2"
+)
+
+type codexTransportTraceKey struct{}
+
+// Metadata only: no headers, URLs, payloads, credentials or raw error strings.
+// Each RoundTrip has its own attempt ID, including retries of the same request.
+type codexTransportTrace struct {
+	mu        sync.Mutex
+	ctx       context.Context
+	started   time.Time
+	attempt   string
+	requestID string
+	localPort int
+	protocol  string
+	firstBody sync.Once
+	finished  sync.Once
+}
+
+func beginCodexTransportTrace(req *http.Request) (*http.Request, *codexTransportTrace) {
+	if req == nil || req.URL == nil || req.URL.Hostname() != "chatgpt.com" {
+		return req, nil
+	}
+	flag := os.Getenv("CPA_CODEX_TRANSPORT_TRACE_FILE")
+	if flag == "" {
+		return req, nil
+	}
+	if info, err := os.Stat(flag); err != nil || !info.Mode().IsRegular() {
+		return req, nil
+	}
+	t := &codexTransportTrace{ctx: req.Context(), started: time.Now(), attempt: uuid.NewString()}
+	if id, err := uuid.Parse(logging.GetRequestID(req.Context())); err == nil {
+		t.requestID = id.String()
+	}
+	ctx := context.WithValue(req.Context(), codexTransportTraceKey{}, t)
+	ctx = httptrace.WithClientTrace(ctx, &httptrace.ClientTrace{
+		WroteRequest:         func(info httptrace.WroteRequestInfo) { t.event("request_written", info.Err, nil) },
+		GotFirstResponseByte: func() { t.event("first_response_byte", nil, nil) },
+	})
+	t.event("start", nil, nil)
+	return req.WithContext(ctx), t
+}
+
+func transportTrace(ctx context.Context) *codexTransportTrace {
+	if ctx == nil {
+		return nil
+	}
+	t, _ := ctx.Value(codexTransportTraceKey{}).(*codexTransportTrace)
+	return t
+}
+
+func traceErrorClass(err error) string {
+	if err == nil {
+		return "none"
+	}
+	if errors.Is(err, context.Canceled) {
+		return "context_canceled"
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		return "deadline_exceeded"
+	}
+	if errors.Is(err, io.EOF) {
+		return "eof"
+	}
+	if errors.Is(err, io.ErrUnexpectedEOF) {
+		return "unexpected_eof"
+	}
+	if errors.Is(err, syscall.ECONNRESET) {
+		return "connection_reset"
+	}
+	if errors.Is(err, syscall.ECONNREFUSED) {
+		return "connection_refused"
+	}
+	var se http2.StreamError
+	if errors.As(err, &se) {
+		return "h2_stream_" + se.Code.String()
+	}
+	var ce http2.ConnectionError
+	if errors.As(err, &ce) {
+		return "h2_connection_" + http2.ErrCode(ce).String()
+	}
+	var ne net.Error
+	if errors.As(err, &ne) && ne.Timeout() {
+		return "network_timeout"
+	}
+	return "other"
+}
+
+func (t *codexTransportTrace) event(stage string, err error, extra log.Fields) {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	fields := log.Fields{"trace_attempt": t.attempt, "stage": stage, "elapsed_ms": time.Since(t.started).Milliseconds(), "local_port": t.localPort, "protocol": t.protocol, "error_class": traceErrorClass(err), "context_state": traceErrorClass(t.ctx.Err()), "at_utc": time.Now().UTC().Format(time.RFC3339Nano)}
+	if t.requestID != "" {
+		fields["request_id"] = t.requestID
+	}
+	for k, v := range extra {
+		fields[k] = v
+	}
+	t.mu.Unlock()
+	log.WithFields(fields).Info("codex_transport_trace")
+}
+
+func (t *codexTransportTrace) connection(conn net.Conn) {
+	if t == nil || conn == nil {
+		return
+	}
+	if addr, ok := conn.LocalAddr().(*net.TCPAddr); ok {
+		t.mu.Lock()
+		t.localPort = addr.Port
+		t.mu.Unlock()
+	}
+}
+
+func (t *codexTransportTrace) negotiated(protocol string) {
+	if t == nil {
+		return
+	}
+	if protocol == "" {
+		protocol = "http/1.1"
+	}
+	if protocol != "h2" && protocol != "http/1.1" {
+		protocol = "other"
+	}
+	t.mu.Lock()
+	t.protocol = protocol
+	t.mu.Unlock()
+}
+
+func (t *codexTransportTrace) finish(stage string, err error) {
+	if t != nil {
+		t.finished.Do(func() { t.event(stage, err, nil) })
+	}
+}
+
+type codexTraceBody struct {
+	io.ReadCloser
+	trace *codexTransportTrace
+}
+
+func (b *codexTraceBody) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	if n > 0 {
+		b.trace.firstBody.Do(func() { b.trace.event("first_body_read", nil, nil) })
+	}
+	if err != nil {
+		b.trace.finish("body_end", err)
+	}
+	return n, err
+}
+func (b *codexTraceBody) Close() error {
+	err := b.ReadCloser.Close()
+	b.trace.finish("body_closed", err)
+	return err
+}
diff --git a/internal/runtime/executor/helps/codex_transport_trace_test.go b/internal/runtime/executor/helps/codex_transport_trace_test.go
