* text=auto eol=lf
## Embedded upstream assets retain exact release bytes; Go source still uses LF.
plugin-freetier/internal/admin/console.html -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
plugin-freetier/internal/vendors/**/assets/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text
*.ico -text
*.woff -text
*.woff2 -text
*.bin -text
# Preserve upstream vendored renderers byte-for-byte; do not reformat them.
plugin/internal/plugin/web/vendor/* -whitespace
